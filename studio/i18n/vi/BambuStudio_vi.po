msgctxt "amsdrying"
msgid "Back"
msgstr "Quay lại"

msgid "Drying-Heating"
msgstr "Sấy - Gia nhiệt"

msgid "Drying-Dehumidifying"
msgstr "Sấy - Hút ẩm"

msgid " maximum drying temperature is "
msgstr " nhiệt độ sấy tối đa là "

msgid " minimum drying temperature is "
msgstr " nhiệt độ sấy tối thiểu là "

msgid "This filament may not be completely dried."
msgstr "Filament này có thể chưa được sấy khô hoàn toàn."

msgid ""
"This AMS is currently printing. To ensure print quality, the drying "
"temperature cannot exceed the recommended drying temperature."
msgstr ""
"AMS này đang in. Để đảm bảo chất lượng in, nhiệt độ sấy không được vượt quá "
"nhiệt độ sấy khuyến nghị."

msgid ""
"The temperature shall not exceed the filament's heat distortion temperature"
msgstr "Nhiệt độ không được vượt quá nhiệt độ biến dạng nhiệt của filament"

msgid "Minimum time value cannot be less than 1."
msgstr "Thời gian tối thiểu không được nhỏ hơn 1."

msgid "Maximum time value cannot be greater than 24."
msgstr "Thời gian tối đa không được lớn hơn 24."

msgid "Insufficient power"
msgstr "Không đủ điện"

msgid ""
"  Too many AMS drying simultaneously. Please plug in the power or stop other"
" drying processes before starting."
msgstr ""
"  Có quá nhiều AMS đang sấy cùng lúc. Vui lòng cắm nguồn điện hoặc dừng các "
"quá trình sấy khác trước khi bắt đầu."

msgid "AMS is busy"
msgstr "AMS đang bận"

msgid ""
"  AMS is calibrating | reading RFID | loading/unloading material, please "
"wait."
msgstr "  AMS đang hiệu chuẩn | đọc RFID | nạp/rút filament, vui lòng chờ."

msgid "Filament in AMS outlet"
msgstr "Filament ở cửa ra AMS"

msgid ""
"  The high drying temperature may cause AMS blockage, please unload first."
msgstr ""
"  Nhiệt độ sấy cao có thể gây tắc AMS, vui lòng rút filament ra trước."

msgid "Initiating AMS drying"
msgstr "Đang khởi động sấy AMS"

msgid "Not supported in 2D mode"
msgstr "Không hỗ trợ ở chế độ 2D"

msgid "Task in progress"
msgstr "Đang có tác vụ"

msgid "  The AMS might be in use during Task."
msgstr "  AMS có thể đang được dùng trong tác vụ."

msgid "  Firmware update in progress, please wait..."
msgstr "  Đang cập nhật firmware, vui lòng chờ..."

msgid "  Please plug in the power and then use the drying function."
msgstr "  Vui lòng cắm nguồn điện rồi dùng chức năng sấy."

msgid ""
"  The high drying temperature may cause AMS blockage. Please unload the "
"filament manually before proceeding."
msgstr ""
"  Nhiệt độ sấy cao có thể gây tắc AMS. Vui lòng rút filament thủ công trước "
"khi tiếp tục."

msgid "System is busy"
msgstr "Hệ thống đang bận"

msgid "  Initiating other drying processes, please wait a few seconds..."
msgstr "  Đang khởi động quá trình sấy khác, vui lòng chờ vài giây..."

msgid "For better drying results, remove the filament and allow it to rotate."
msgstr "Để sấy hiệu quả hơn, hãy tháo filament ra để cuộn có thể xoay."

msgid ""
"The AMS will automatically rotate the stored filament slots to enhance the "
"drying performance."
msgstr ""
"AMS sẽ tự động xoay các khe có filament đã được cất để sấy hiệu quả hơn."

msgid "Alternatively, you can dry the filament without removing it."
msgstr "Bạn cũng có thể sấy filament mà không cần tháo ra."

msgid "Unknown filaments will be treated as PLA."
msgstr "Filament không xác định sẽ được coi là PLA."

msgid "Please store the filament marked with an exclamation mark."
msgstr "Vui lòng cất filament có đánh dấu chấm than."

msgid ""
"Filament left in the feeder during drying may soften because the drying "
"temperature exceeds the softening point of materials like PLA and TPU."
msgstr ""
"Filament còn trong bộ nạp khi sấy có thể bị mềm, vì nhiệt độ sấy vượt quá "
"điểm hóa mềm của các vật liệu như PLA và TPU."

