+// Runs an /opt/studio-ai command without blocking; done runs on the UI thread once it exits. Returns its
+// pid, or 0 when it could not be started. `flags` adds wxExecute flags (wxEXEC_MAKE_GROUP_LEADER).
+long ai_run_async(const std::string &command, std::function<void()> done, int flags = 0)
+{
+    auto *process = new wxProcess();
+    process->Bind(wxEVT_END_PROCESS, [process, done](wxProcessEvent &) {
+        // Deleted once its own event is done with it
+        wxTheApp->CallAfter([process]() { delete process; });
+        done();
+    });
+    // On failure the process object is left alone: leaking it beats a double delete if wx frees it
+    const long pid = wxExecute(wxString::FromUTF8(command), wxEXEC_ASYNC | flags, process);
+    return pid > 0 ? pid : 0;
+}
