+class AiProgressDialog : public wxDialog
+{
+public:
+    AiProgressDialog(wxWindow *parent, const wxString &plate, std::function<void()> on_cancel)
+        : wxDialog(parent, wxID_ANY, wxString::FromUTF8("AI tối ưu: đang phân tích"), wxDefaultPosition, wxDefaultSize, wxCAPTION | wxSYSTEM_MENU | wxCLOSE_BOX)
