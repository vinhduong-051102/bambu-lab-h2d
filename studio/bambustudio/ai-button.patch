+            sizer->Add(m_steps[i], 0, wxLEFT | wxRIGHT | wxTOP, gap);
+        }
+        m_plate = plate;
+        // Claude's analysis lines as it writes them (on-click asks for them before the answer)
+        m_notes = new wxTextCtrl(this, wxID_ANY, wxString::FromUTF8("Claude đang suy nghĩ, phân tích sẽ hiện ở đây..."), wxDefaultPosition,
+                                 wxSize(FromDIP(480), FromDIP(170)), wxTE_MULTILINE | wxTE_READONLY | wxTE_WORDWRAP);
+        sizer->Add(m_notes, 1, wxLEFT | wxRIGHT | wxTOP | wxEXPAND, gap);
+        m_gauge = new wxGauge(this, wxID_ANY, 100, wxDefaultPosition, wxSize(FromDIP(420), FromDIP(8)));
+        sizer->Add(m_gauge, 0, wxALL | wxEXPAND, gap);
+        m_detail = new wxStaticText(this, wxID_ANY, wxEmptyString);
+        sizer->Add(m_detail, 0, wxLEFT | wxRIGHT | wxEXPAND, gap);
