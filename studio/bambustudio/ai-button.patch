+// Session ids go on a command line: only the gateway's own shape (digits, a-f and dashes) is used
+bool ai_safe_id(const std::string &id)
+{
+    return !id.empty() && id.size() <= 64 && std::all_of(id.begin(), id.end(), [](char c) { return std::isdigit((unsigned char) c) || (c >= 'a' && c <= 'f') || c == '-'; });
+}
+
+
+// Photo names go on a command line too: only the gateway's own shape (letters, digits, dashes, one extension)
+bool ai_safe_photo(const std::string &name)
+{
+    return !name.empty() && name.size() <= 64 && name.find("..") == std::string::npos &&
+           std::all_of(name.begin(), name.end(), [](char c) { return std::isalnum((unsigned char) c) || c == '-' || c == '.'; });
+}
+
+// Runs an /opt/studio-ai command without blocking; done runs on the UI thread once it exits. False when it
+// could not be started.
+bool ai_run_async(const std::string &command, std::function<void()> done)
+{
+    auto *process = new wxProcess();
+    process->Bind(wxEVT_END_PROCESS, [process, done](wxProcessEvent &) {
+        // Deleted once its own event is done with it
+        wxTheApp->CallAfter([process]() { delete process; });
+        done();
+    });
+    // On failure the process object is left alone: leaking it beats a double delete if wx frees it
+    return wxExecute(wxString::FromUTF8(command), wxEXEC_ASYNC, process) > 0;
+}
