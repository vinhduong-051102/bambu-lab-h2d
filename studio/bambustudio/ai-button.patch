+            const bool with_ai = p.contains("ai_session_id") && p["ai_session_id"].is_string();
+            // Studio runs with LC_ALL=C, so text with accents or symbols always goes through FromUTF8
+            labels.Add(wxString::Format(wxString::FromUTF8("%s · %s · %s%s%s"), ai_session_time(p.value("id", "")), name,
+                                        wxString::FromUTF8(status_text), wxString::FromUTF8(with_ai ? " · AI" : ""),
