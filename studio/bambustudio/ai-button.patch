+const char *ai_volume_type(ModelVolumeType type)
+{
+    switch (type) {
+    case ModelVolumeType::MODEL_PART: return "part";
+    case ModelVolumeType::NEGATIVE_VOLUME: return "negative";
+    case ModelVolumeType::PARAMETER_MODIFIER: return "modifier";
+    case ModelVolumeType::SUPPORT_BLOCKER: return "support_blocker";
+    case ModelVolumeType::SUPPORT_ENFORCER: return "support_enforcer";
+    default: return "other";
+    }
+}
+
+// Geometry of one placed instance: what the AI needs to judge supports, brim and strength, and the plate it
+// is on (1-based), so the AI knows which objects print together
+nlohmann::json ai_describe_object(const ModelObject &object, int obj_idx)
+{
+    TriangleMesh mesh = object.raw_mesh();
+    if (!object.instances.empty())
+        object.instances.front()->transform_mesh(&mesh);
+    const indexed_triangle_set &its = mesh.its;
+    const BoundingBoxf3 bbox = mesh.bounding_box();
+    const double cos45 = std::sqrt(0.5);
+
+    double surface = 0., base = 0., overhang = 0.;
+    for (const auto &face : its.indices) {
+        const Vec3d a = its.vertices[face[0]].cast<double>();
+        const Vec3d b = its.vertices[face[1]].cast<double>();
+        const Vec3d c = its.vertices[face[2]].cast<double>();
+        const Vec3d normal = (b - a).cross(c - a);
+        const double twice_area = normal.norm();
+        if (twice_area <= 0.)
+            continue;
+        surface += twice_area / 2.;
+        const double nz = normal.z() / twice_area;
+        // Facing down within 45° of horizontal: resting on the bed, or an overhang that needs support
+        if (nz < -cos45) {
+            const double projected = twice_area / 2. * -nz;
+            if (std::max({a.z(), b.z(), c.z()}) < bbox.min.z() + 0.05)
+                base += projected;
+            else
+                overhang += projected;
+        }
+    }
+
+    const Vec3d size = bbox.size();
+    nlohmann::json described = {
+        {"name", object.name},
+        {"instances", object.instances.size()},
+        {"size_mm", {std::round(size.x() * 10.) / 10., std::round(size.y() * 10.) / 10., std::round(size.z() * 10.) / 10.}},
+        {"volume_mm3", std::round(std::abs(its_volume(its)))},
+        {"surface_area_mm2", std::round(surface)},
+        {"base_area_mm2", std::round(base)},
+        {"overhang_area_mm2", std::round(overhang)},
+        {"triangles", its.indices.size()},
+    };
+    // What the object already has set apart from the process preset: it wins over the preset when slicing, and its
+    // parts' (modifiers') and height ranges' settings win over the object's
+    if (!object.config.empty())
+        described["settings"] = ai_config_json(object.config);
+    nlohmann::json parts = nlohmann::json::array();
+    for (const ModelVolume *volume : object.volumes)
+        if (!volume->config.empty())
+            parts.push_back({{"name", volume->name}, {"type", ai_volume_type(volume->type())}, {"settings", ai_config_json(volume->config)}});
+    if (!parts.empty())
+        described["parts"] = parts;
+    nlohmann::json ranges = nlohmann::json::array();
+    for (const auto &[range, config] : object.layer_config_ranges)
+        if (!config.empty())
+            ranges.push_back({{"from_mm", std::round(range.first * 100.) / 100.}, {"to_mm", std::round(range.second * 100.) / 100.},
+                              {"settings", ai_config_json(config)}});
+    if (!ranges.empty())
+        described["height_ranges"] = ranges;
+    const int plate = wxGetApp().plater()->get_partplate_list().find_instance(obj_idx, 0);
+    if (plate >= 0) {
+        described["plate"] = plate + 1;
+        if (PartPlate *on = wxGetApp().plater()->get_partplate_list().get_plate(plate))
+        {
+            described["footprint"] = ai_footprint(its, on->get_origin());
+            described["outline"] = ai_outline(its, on->get_origin());
+        }
+    }
+    return described;
+}
