+        detail_row->Add(m_photo, 0, wxRIGHT, gap);
+        m_detail = new wxStaticText(this, wxID_ANY, wxEmptyString);
+        detail_row->Add(m_detail, 1, wxEXPAND);
+        sizer->Add(detail_row, 0, wxLEFT | wxRIGHT | wxEXPAND, gap);
+
+        wxArrayString outcome_labels;
+        for (const nlohmann::json &o : m_outcomes)
+            outcome_labels.Add(wxString::FromUTF8(o.value("label", "")));
+        m_outcome = new wxRadioBox(this, wxID_ANY, wxString::FromUTF8("Kết quả in"), wxDefaultPosition, wxDefaultSize, outcome_labels,
+                                   int(outcome_labels.size()), wxRA_SPECIFY_COLS);
+        sizer->Add(m_outcome, 0, wxALL | wxEXPAND, gap);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Lỗi gặp phải:")), 0, wxLEFT | wxRIGHT, gap);
+        wxArrayString issue_labels;
+        for (const nlohmann::json &issue : m_issues)
