+// The steps of a click, in order, by the names on-click writes to response.json.progress
+struct AiStep
+{
+    const char *id;
+    const char *label;
+};
+const AiStep AI_STEPS[] = {
+    {"read", "Đọc mẫu và setting trong Studio"},
+    {"prompt", "Gửi cho gateway, dựng yêu cầu cho AI"},
+    {"thinking", "Claude phân tích hình dạng mẫu, vật liệu và setting"},
+    {"writing", "Claude viết đề xuất"},
+    {"check", "Gateway kiểm tra đề xuất"},
+};
+const int AI_STEP_COUNT = int(sizeof(AI_STEPS) / sizeof(AI_STEPS[0]));
+
+// What the AI is doing while the user waits: the steps done and to come, the time so far, and how many
+// changes Claude has written. A plain modeless dialog (not a wxPopupTransientWindow, which grabs input on
+// GTK): the user keeps working in Studio, hides it, or cancels the click.
+class AiProgressDialog : public wxDialog
+{
+public:
+    AiProgressDialog(wxWindow *parent, const wxString &plate, std::function<void()> on_cancel)
+        : wxDialog(parent, wxID_ANY, wxString::FromUTF8("AI tối ưu: đang phân tích"), wxDefaultPosition, wxDefaultSize, wxCAPTION | wxSYSTEM_MENU | wxCLOSE_BOX)
+    {
+        const int gap = FromDIP(12);
+        auto *sizer = new wxBoxSizer(wxVERTICAL);
+        for (int i = 0; i < AI_STEP_COUNT; ++i) {
+            m_steps[i] = new wxStaticText(this, wxID_ANY, wxEmptyString);
+            sizer->Add(m_steps[i], 0, wxLEFT | wxRIGHT | wxTOP, gap);
+        }
+        m_plate = plate;
+        // Claude's analysis lines as it writes them (on-click asks for them before the answer)
+        m_notes = new wxTextCtrl(this, wxID_ANY, wxString::FromUTF8("Claude đang suy nghĩ, phân tích sẽ hiện ở đây..."), wxDefaultPosition,
+                                 wxSize(FromDIP(480), FromDIP(170)), wxTE_MULTILINE | wxTE_READONLY | wxTE_WORDWRAP);
+        sizer->Add(m_notes, 1, wxLEFT | wxRIGHT | wxTOP | wxEXPAND, gap);
+        m_gauge = new wxGauge(this, wxID_ANY, 100, wxDefaultPosition, wxSize(FromDIP(420), FromDIP(8)));
+        sizer->Add(m_gauge, 0, wxALL | wxEXPAND, gap);
+        m_detail = new wxStaticText(this, wxID_ANY, wxEmptyString);
+        sizer->Add(m_detail, 0, wxLEFT | wxRIGHT | wxEXPAND, gap);
+
+        auto *buttons = new wxBoxSizer(wxHORIZONTAL);
+        m_cancel = new wxButton(this, wxID_ANY, wxString::FromUTF8("Hủy"));
+        auto *hide = new wxButton(this, wxID_ANY, wxString::FromUTF8("Ẩn"));
+        buttons->AddStretchSpacer();
+        buttons->Add(m_cancel, 0, wxRIGHT, FromDIP(8));
+        buttons->Add(hide);
+        sizer->Add(buttons, 0, wxALL | wxEXPAND, gap);
+
+        m_cancel->Bind(wxEVT_BUTTON, [this, on_cancel](wxCommandEvent &) {
+            m_cancel->Enable(false);
+            m_detail->SetLabel(wxString::FromUTF8("Đang hủy..."));
+            on_cancel();
+        });
+        hide->Bind(wxEVT_BUTTON, [this](wxCommandEvent &) { Hide(); });
+        // The title bar's close button hides too: the click goes on, and the AI button shows this again
+        Bind(wxEVT_CLOSE_WINDOW, [this](wxCloseEvent &event) {
+            if (event.CanVeto()) {
+                event.Veto();
+                Hide();
+            } else
+                event.Skip();
+        });
+
+        show_step(0, wxEmptyString, wxEmptyString);
+        SetSizerAndFit(sizer);
+        CentreOnParent();
+    }
+
+    // Marks the steps before `current` done; `detail` goes under the progress bar, `notes` (one per line)
+    // in the analysis box, which keeps its placeholder until Claude writes the first one
+    void show_step(int current, const wxString &detail, const wxString &notes)
+    {
+        if (!notes.empty() && m_notes->GetValue() != notes) {
+            m_notes->ChangeValue(notes);
+            m_notes->ShowPosition(m_notes->GetLastPosition());
+        }
+        for (int i = 0; i < AI_STEP_COUNT; ++i) {
+            wxString label = wxString::FromUTF8(i < current ? "✓  " : i == current ? "●  " : "○  ") + wxString::FromUTF8(AI_STEPS[i].label);
+            if (i == 0)
+                label += m_plate;
+            if (m_steps[i]->GetLabel() != label)
+                m_steps[i]->SetLabel(label);
+            m_steps[i]->Enable(i <= current);
+        }
+        if (m_cancel->IsEnabled() && m_detail->GetLabel() != detail) {
+            m_detail->SetLabel(detail);
+            Layout();
+        }
+        m_gauge->Pulse();
+    }
+
+private:
+    wxString      m_plate;
+    wxStaticText *m_steps[AI_STEP_COUNT];
+    wxStaticText *m_detail;
+    wxTextCtrl   *m_notes;
+    wxGauge      *m_gauge;
+    wxButton     *m_cancel;
+};
