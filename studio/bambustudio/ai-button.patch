+// The progress on-click last wrote, or nullopt while there is none; quiet, as it is read twice a second
+std::optional<nlohmann::json> ai_read_progress(const std::string &path)
+{
+    std::ifstream in(path, std::ios::binary);
+    if (!in)
+        return std::nullopt;
+    nlohmann::json progress = nlohmann::json::parse(in, nullptr, false);
+    if (progress.is_discarded() || !progress.is_object())
+        return std::nullopt;
+    return progress;
+}
