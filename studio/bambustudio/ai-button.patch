+        auto *hide = new wxButton(this, wxID_ANY, wxString::FromUTF8("Ẩn"));
+        buttons->AddStretchSpacer();
+        buttons->Add(m_cancel, 0, wxRIGHT, FromDIP(8));
+        buttons->Add(hide);
+        sizer->Add(buttons, 0, wxALL | wxEXPAND, gap);
