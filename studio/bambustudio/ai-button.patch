+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Ghi chú (vị trí lỗi, bạn đã chỉnh gì thêm...):")), 0, wxLEFT | wxRIGHT, gap);
+        m_note = new wxTextCtrl(this, wxID_ANY, wxEmptyString, wxDefaultPosition, wxSize(FromDIP(600), FromDIP(80)), wxTE_MULTILINE | wxTE_WORDWRAP);
+        sizer->Add(m_note, 0, wxALL | wxEXPAND, gap);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Thêm ảnh chụp và so sánh các bản in trên dashboard, thẻ Lịch sử in.")),
+                   0, wxLEFT | wxRIGHT, gap);
