+// "AI tối ưu" (bambu-lab-h2d patch). Studio writes a description of the plate to request.json and runs
+// /opt/studio-ai/on-click <request.json> <response.json> (mounted from the host, so it changes without a
+// rebuild). The hook asks the gateway, which asks Claude; Studio then shows the proposed process settings
+// and loads the accepted ones into the edited process preset, like a manual edit (orange, resettable).
+namespace {
+const std::string AI_HOOK = "/opt/studio-ai/on-click";
+const std::string AI_DIR  = "/tmp/studio-ai";
+
+std::vector<double> ai_floats(const DynamicPrintConfig &config, const std::string &key)
+{
+    const ConfigOption *opt = config.option(key);
+    if (auto *nullable = dynamic_cast<const ConfigOptionFloatsNullable *>(opt))
+        return nullable->values;
+    if (auto *floats = dynamic_cast<const ConfigOptionFloats *>(opt))
+        return floats->values;
+    return {};
+}
+
+// Geometry of one placed instance: what the AI needs to judge supports, brim and strength
+nlohmann::json ai_describe_object(const ModelObject &object)
+{
+    TriangleMesh mesh = object.raw_mesh();
+    if (!object.instances.empty())
+        object.instances.front()->transform_mesh(&mesh);
+    const indexed_triangle_set &its = mesh.its;
+    const BoundingBoxf3 bbox = mesh.bounding_box();
+    const double cos45 = std::sqrt(0.5);
+
+    double surface = 0., base = 0., overhang = 0.;
+    for (const auto &face : its.indices) {
+        const Vec3d a = its.vertices[face[0]].cast<double>();
+        const Vec3d b = its.vertices[face[1]].cast<double>();
+        const Vec3d c = its.vertices[face[2]].cast<double>();
+        const Vec3d normal = (b - a).cross(c - a);
+        const double twice_area = normal.norm();
+        if (twice_area <= 0.)
+            continue;
+        surface += twice_area / 2.;
+        const double nz = normal.z() / twice_area;
+        // Facing down within 45° of horizontal: resting on the bed, or an overhang that needs support
+        if (nz < -cos45) {
+            const double projected = twice_area / 2. * -nz;
+            if (std::max({a.z(), b.z(), c.z()}) < bbox.min.z() + 0.05)
+                base += projected;
+            else
+                overhang += projected;
+        }
+    }
+
+    const Vec3d size = bbox.size();
+    return {
+        {"name", object.name},
+        {"instances", object.instances.size()},
+        {"size_mm", {std::round(size.x() * 10.) / 10., std::round(size.y() * 10.) / 10., std::round(size.z() * 10.) / 10.}},
+        {"volume_mm3", std::round(std::abs(its_volume(its)))},
+        {"surface_area_mm2", std::round(surface)},
+        {"base_area_mm2", std::round(base)},
+        {"overhang_area_mm2", std::round(overhang)},
+        {"triangles", its.indices.size()},
+    };
+}
+
+nlohmann::json ai_describe_plate()
+{
+    PresetBundle &bundle = *wxGetApp().preset_bundle;
+    const DynamicPrintConfig &print_config = bundle.prints.get_edited_preset().config;
+
+    nlohmann::json filaments = nlohmann::json::array();
+    for (const std::string &name : bundle.filament_presets) {
+        nlohmann::json filament = {{"preset", name}};
+        const Preset *preset = bundle.filaments.find_preset(name, false);
+        if (preset && preset->config.has("filament_type"))
+            filament["type"] = preset->config.opt_string("filament_type", 0u);
+        filaments.push_back(filament);
+    }
+
+    // The whole process preset: the gateway picks the settings the AI may change
+    // (src/domain/studio/aiOptimize.ts), so changing that list needs no rebuild. Text settings
+    // (names, notes, scripts) are left out: none is for the AI, and they may hold anything.
+    nlohmann::json settings = nlohmann::json::object();
+    for (const std::string &key : print_config.keys()) {
+        const ConfigOptionDef *def = print_config_def.get(key);
+        if (def != nullptr && def->type != coString && def->type != coStrings)
+            settings[key] = print_config.opt_serialize(key);
+    }
+
+    nlohmann::json objects = nlohmann::json::array();
+    for (const ModelObject *object : wxGetApp().plater()->model().objects)
+        objects.push_back(ai_describe_object(*object));
+
+    return {
+        {"version", 1},
+        {"printer_preset", bundle.printers.get_edited_preset().name},
+        {"process_preset", bundle.prints.get_edited_preset().name},
+        {"nozzle_diameters", ai_floats(bundle.printers.get_edited_preset().config, "nozzle_diameter")},
+        {"filaments", filaments},
+        {"settings", settings},
+        {"objects", objects},
+    };
+}
+
+wxString ai_text(const nlohmann::json &value, const char *key)
+{
+    auto it = value.find(key);
+    return it != value.end() && it->is_string() ? wxString::FromUTF8(it->get<std::string>()) : wxString();
+}
+// Runs a gateway route for Studio: gateway <GET|POST> <path under /api> <body.json|-> <response.json>
+const std::string AI_GATEWAY = "/opt/studio-ai/gateway";
+
+void ai_write_json(const std::string &path, const nlohmann::json &value)
+{
+    boost::filesystem::create_directories(AI_DIR);
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out << value.dump(1);
+    if (!out)
+        throw std::runtime_error("cannot write " + path);
+}
+
+// The JSON a hook wrote, or nullopt (logged) when it is missing or unreadable
+std::optional<nlohmann::json> ai_read_json(const std::string &path)
+{
+    try {
+        std::ifstream in(path, std::ios::binary);
+        return nlohmann::json::parse(in);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI: unreadable " << path << ": " << e.what();
+        return std::nullopt;
+    }
+}
+
+wxString ai_trimmed(wxString text)
+{
+    text.Trim(true).Trim(false);
+    return text;
+}
+
+// "20261022-141503-a1b2c3" (the gateway's local time) → "22/10 14:15"
+wxString ai_session_time(const std::string &id)
+{
+    if (id.size() < 13)
+        return wxString::FromUTF8(id);
+    return wxString::FromUTF8(id.substr(6, 2) + "/" + id.substr(4, 2) + " " + id.substr(9, 2) + ":" + id.substr(11, 2));
+}
