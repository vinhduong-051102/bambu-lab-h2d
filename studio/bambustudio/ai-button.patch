+// The steps of a click, in order, by the names on-click writes to response.json.progress
+struct AiStep
+{
+    const char *id;
+    const char *label;
+};
+const AiStep AI_STEPS[] = {
+    {"read", "Đọc mẫu và setting trong Studio"},
+    {"prompt", "Gửi cho gateway, dựng yêu cầu cho AI"},
+    {"thinking", "Claude phân tích hình dạng mẫu, vật liệu và setting"},
+    {"writing", "Claude viết đề xuất"},
+    {"check", "Gateway kiểm tra đề xuất"},
+};
+const int AI_STEP_COUNT = int(sizeof(AI_STEPS) / sizeof(AI_STEPS[0]));
