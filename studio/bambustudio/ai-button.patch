+bool MainFrame::ai_run(const std::string &command, std::function<void()> done)
+{
+    if (ai_run_async(command, std::move(done)))
+        return true;
+    MessageDialog dlg(this, wxString::FromUTF8("Không chạy được ") + wxString::FromUTF8(command), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_ERROR);
+    dlg.ShowModal();
+    return false;
+}
+
+void MainFrame::ai_optimize(const std::string &follow_up_session, const wxString &comment)
+{
+    if (m_ai_running)
+        return;
+    if (!wxFileName::IsFileExecutable(AI_HOOK)) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chức năng AI tối ưu sắp có."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+    if (wxGetApp().plater()->model().objects.empty()) {
+        MessageDialog dlg(this, wxString::FromUTF8("Hãy thêm mẫu lên bàn in trước khi dùng AI tối ưu."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+
+    const std::string request_path  = AI_DIR + "/request.json";
+    const std::string response_path = AI_DIR + "/response.json";
+    try {
+        nlohmann::json request = ai_describe_plate();
+        // "Hỏi lại AI": the gateway puts the earlier proposal and this comment in the prompt
+        if (!follow_up_session.empty())
+            request["follow_up"] = {{"session_id", follow_up_session}, {"comment", comment.ToUTF8().data()}};
+        boost::filesystem::remove(response_path);
+        ai_write_json(request_path, request);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI optimize: " << e.what();
+        MessageDialog dlg(this, wxString::FromUTF8("Không ghi được dữ liệu mẫu để gửi cho AI."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+
+    const bool started = ai_run(AI_HOOK + " " + request_path + " " + response_path, [this, response_path]() {
+        m_ai_running = false;
+        m_ai_btn->SetLabel(wxString::FromUTF8("AI tối ưu"));
+        m_ai_btn->Enable();
+        Layout();
+        ai_optimize_apply(response_path);
+    });
+    if (!started)
+        return;
+    m_ai_running = true;
+    m_ai_btn->SetLabel(wxString::FromUTF8("AI đang phân tích..."));
+    m_ai_btn->Enable(false);
+    Layout();
+}
+
+void MainFrame::ai_optimize_apply(const std::string &response_path)
+{
+    const wxString title = wxString::FromUTF8("AI tối ưu");
+    const std::optional<nlohmann::json> response = ai_read_json(response_path);
+    if (!response) {
+        MessageDialog dlg(this, wxString::FromUTF8("Không đọc được kết quả từ AI. Kiểm tra gateway và STUDIO_AI_URL."), title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    if (!response->value("success", false)) {
+        wxString message = ai_text(*response, "message");
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("AI không xử lý được yêu cầu.") : message, title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    std::string session_id = response->value("session_id", "");
+    if (!ai_safe_id(session_id))
+        session_id.clear();
+
+    // The gateway already checked the keys and values; Studio still refuses anything that is not a
+    // non-text setting of the process preset, and anything its own parser rejects.
+    const DynamicPrintConfig &print_config = wxGetApp().preset_bundle->prints.get_edited_preset().config;
+    DynamicPrintConfig proposed;
+    nlohmann::json applied = nlohmann::json::array();
+    wxString lines;
+    const nlohmann::json changes = response->value("changes", nlohmann::json::array());
+    for (const nlohmann::json &change : changes) {
+        const std::string key   = change.value("key", "");
+        const std::string value = change.value("value", "");
+        const ConfigOptionDef *def = print_config_def.get(key);
+        if (def == nullptr || def->type == coString || def->type == coStrings || !print_config.has(key))
+            continue;
+        try {
+            ConfigSubstitutionContext context(ForwardCompatibilitySubstitutionRule::Disable);
+            proposed.set_deserialize(key, value, context);
+        } catch (const std::exception &e) {
+            BOOST_LOG_TRIVIAL(warning) << "AI optimize: " << key << " = " << value << " rejected: " << e.what();
+            continue;
+        }
+        applied.push_back({{"key", key}, {"value", value}});
+        wxString label = ai_text(change, "label");
+        lines += wxString::Format(wxString::FromUTF8("• %s: %s → %s\n   %s\n\n"), label.empty() ? wxString::FromUTF8(key) : label,
+                                  wxString::FromUTF8(print_config.opt_serialize(key)), wxString::FromUTF8(value), ai_text(change, "reason"));
+    }
+    if (proposed.empty())
+        lines = wxString::FromUTF8("Setting hiện tại đã phù hợp, AI không đề xuất thay đổi nào.");
+
+    AiResultDialog dlg(this, ai_text(*response, "summary"), lines, !proposed.empty());
+    const int answer = dlg.ShowModal();
+    if (answer == ID_AI_ASK_AGAIN) {
+        // Back to the button's busy state; the new answer opens this dialog again
+        const wxString comment = dlg.comment();
+        CallAfter([this, session_id, comment]() { ai_optimize(session_id, comment); });
+        return;
+    }
+    if (answer != wxID_APPLY)
+        return;
+
+    // Same follow-up as editing the density in the Process tab (Tab::on_value_change)
+    if (proposed.has("sparse_infill_density")) {
+        for (const char *linked : {"skeleton_infill_density", "skin_infill_density"})
+            if (print_config.has(linked))
+                proposed.set_key_value(linked, proposed.option("sparse_infill_density")->clone());
+    }
+    if (Tab *tab = wxGetApp().get_tab(Preset::TYPE_PRINT))
+        tab->load_config(proposed);
+    // The next print sent from Studio is linked to this proposal in the print history
+    m_ai_last_applied_session = session_id;
+
+    // Lets the print report know which proposal was used; nothing for the user to wait on or see
+    if (!session_id.empty() && wxFileName::IsFileExecutable(AI_GATEWAY)) {
+        try {
+            const std::string body = AI_DIR + "/applied.json";
+            ai_write_json(body, {{"changes", applied}});
+            ai_run(AI_GATEWAY + " POST studio/ai-sessions/" + session_id + "/applied " + body + " " + AI_DIR + "/applied-response.json", []() {});
+        } catch (const std::exception &e) {
+            BOOST_LOG_TRIVIAL(warning) << "AI optimize: applied changes not recorded: " << e.what();
+        }
+    }
+}
+
+void MainFrame::ai_report()
+{
+    if (m_ai_reporting)
+        return;
+    const wxString title = wxString::FromUTF8("Báo cáo kết quả in");
+    if (!wxFileName::IsFileExecutable(AI_GATEWAY)) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chưa có script /opt/studio-ai/gateway để gửi báo cáo."), title, wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+    const std::string list_path = AI_DIR + "/prints.json";
+    try {
+        boost::filesystem::create_directories(AI_DIR);
+        boost::filesystem::remove(list_path);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI report: " << e.what();
+    }
+
+    const bool started = ai_run(AI_GATEWAY + " GET prints?limit=30 - " + list_path, [this, list_path]() {
+        m_ai_reporting = false;
+        m_ai_report_btn->Enable();
+        ai_report_show(list_path);
+    });
+    if (!started)
+        return;
+    m_ai_reporting = true;
+    m_ai_report_btn->Enable(false);
+}
+
+void MainFrame::ai_report_show(const std::string &list_path)
+{
+    const wxString title = wxString::FromUTF8("Báo cáo kết quả in");
+    const std::optional<nlohmann::json> list = ai_read_json(list_path);
+    if (!list || !list->value("success", false)) {
+        wxString message = list ? ai_text(*list, "message") : wxString();
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("Không lấy được lịch sử in từ gateway.") : message, title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    if (list->value("prints", nlohmann::json::array()).empty()) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chưa có bản in nào được ghi lại. Gateway ghi lại mỗi bản in gửi từ Studio, kèm ảnh camera khi in xong."),
+                          title, wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+
+    AiReportDialog dlg(this, *list);
+    if (dlg.ShowModal() != wxID_OK || !ai_safe_id(dlg.print_id()))
+        return;
+    const std::string body          = AI_DIR + "/feedback.json";
+    const std::string response_path = AI_DIR + "/feedback-response.json";
+    try {
+        boost::filesystem::remove(response_path);
+        ai_write_json(body, dlg.feedback());
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI report: " << e.what();
+        MessageDialog error(this, wxString::FromUTF8("Không ghi được báo cáo để gửi."), title, wxOK | wxICON_ERROR);
+        error.ShowModal();
+        return;
+    }
+    ai_run(AI_GATEWAY + " POST prints/" + dlg.print_id() + "/feedback " + body + " " + response_path, [this, response_path, title]() {
+        const std::optional<nlohmann::json> response = ai_read_json(response_path);
+        const bool ok = response && response->value("success", false);
+        wxString message = ok ? wxString::FromUTF8("Đã gửi báo cáo. Cảm ơn bạn!") : (response ? ai_text(*response, "message") : wxString());
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("Không gửi được báo cáo.") : message, title, wxOK | (ok ? wxICON_INFORMATION : wxICON_ERROR));
+        dlg.ShowModal();
+    });
+}
+
+void MainFrame::ai_record_print_setup(const std::string &job_name)
+{
+    // Print history: the gateway pairs these settings with the print the printer reports under this job
+    // name. Nothing for the user to wait on or see; a failure only costs the settings in the history.
+    if (job_name.empty() || !wxFileName::IsFileExecutable(AI_GATEWAY))
+        return;
+    try {
+        nlohmann::json setup = ai_describe_plate();
+        setup["job_name"] = job_name;
+        setup["ai_session_id"] = m_ai_last_applied_session.empty() ? nlohmann::json(nullptr) : nlohmann::json(m_ai_last_applied_session);
+        const std::string body = AI_DIR + "/print-setup.json";
+        ai_write_json(body, setup);
+        ai_run_async(AI_GATEWAY + " POST prints/setup " + body + " " + AI_DIR + "/print-setup-response.json", []() {});
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(warning) << "Print history: settings not sent: " << e.what();
+    }
 }
 
