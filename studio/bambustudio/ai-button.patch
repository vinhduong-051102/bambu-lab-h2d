+    std::string print_id() const { return m_prints.at(size_t(m_choice->GetSelection())).value("id", ""); }
+
+    nlohmann::json feedback() const
+    {
+        nlohmann::json issues = nlohmann::json::array();
+        for (unsigned int i = 0; i < m_issue_list->GetCount(); ++i)
+            if (m_issue_list->IsChecked(i))
+                issues.push_back(m_issues.at(i).value("id", ""));
+        return {
+            {"outcome", m_outcomes.at(size_t(m_outcome->GetSelection())).value("id", "")},
+            {"issues", issues},
+            {"note", ai_trimmed(m_note->GetValue()).ToUTF8().data()},
+        };
+    }
+
+private:
+    static constexpr int PHOTO_WIDTH  = 240;
+    static constexpr int PHOTO_HEIGHT = 180;
+
+    void show_detail()
+    {
+        const nlohmann::json &p = m_prints.at(size_t(m_choice->GetSelection()));
+        wxString text = wxString::FromUTF8(p.value("job_name", ""));
+        if (p.contains("process_preset") && p["process_preset"].is_string())
+            text += wxString::FromUTF8("\nPreset: ") + wxString::FromUTF8(p["process_preset"].get<std::string>());
+        else
+            text += wxString::FromUTF8("\nKhông có setting: bản in này không gửi từ Studio.");
+        if (p.contains("ai_session_id") && p["ai_session_id"].is_string())
+            text += wxString::FromUTF8("\nDùng setting AI tối ưu đề xuất.");
+        if (p.contains("feedback_outcome") && p["feedback_outcome"].is_string())
+            text += wxString::FromUTF8("\nĐã có báo cáo: gửi lại sẽ thay báo cáo cũ.");
+        m_detail->SetLabel(text);
+        m_detail->Wrap(FromDIP(340));
+        show_photo(p);
+        Layout();
+    }
+
+    // The newest camera photo (else the newest photo), fetched through the gateway script into AI_DIR
+    void show_photo(const nlohmann::json &print)
+    {
+        m_photo->SetBitmap(wxNullBitmap);
+        const nlohmann::json photos = print.value("photos", nlohmann::json::array());
+        std::string name;
+        for (const nlohmann::json &photo : photos)
+            if (name.empty() || photo.value("source", "") == "camera")
+                name = photo.value("name", "");
+        const std::string id = print.value("id", "");
+        if (name.empty() || !ai_safe_id(id) || !ai_safe_photo(name) || !wxFileName::IsFileExecutable(AI_GATEWAY))
+            return;
+
+        const std::string file = AI_DIR + "/photo-" + name;
+        auto alive = m_alive;
+        const int request = ++m_photo_request;
+        const auto show = [this, alive, request, file]() {
+            // The dialog may be gone, or another print picked, by the time the photo arrives
+            if (!*alive || request != m_photo_request)
+                return;
+            wxImage image;
+            if (!image.LoadFile(wxString::FromUTF8(file)) || !image.IsOk()) {
+                // An error answer, not a photo: fetch it again next time
+                boost::system::error_code ignored;
+                boost::filesystem::remove(file, ignored);
+                return;
+            }
+            const double scale = std::min(double(FromDIP(PHOTO_WIDTH)) / image.GetWidth(), double(FromDIP(PHOTO_HEIGHT)) / image.GetHeight());
+            image.Rescale(std::max(1, int(image.GetWidth() * scale)), std::max(1, int(image.GetHeight() * scale)), wxIMAGE_QUALITY_HIGH);
+            m_photo->SetBitmap(wxBitmap(image));
+            Layout();
+        };
+        if (boost::filesystem::exists(file))
+            show();
+        else
+            ai_run_async(AI_GATEWAY + " GET prints/" + id + "/photos/" + name + " - " + file, show);
+    }
+
+    nlohmann::json        m_prints;
+    nlohmann::json        m_outcomes;
+    nlohmann::json        m_issues;
+    std::shared_ptr<bool> m_alive = std::make_shared<bool>(true);
+    int                   m_photo_request = 0;
+    wxChoice             *m_choice;
+    wxStaticBitmap       *m_photo;
+    wxStaticText         *m_detail;
+    wxRadioBox           *m_outcome;
+    wxCheckListBox       *m_issue_list;
+    wxTextCtrl           *m_note;
+};
