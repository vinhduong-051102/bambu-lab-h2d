+// "AI tối ưu" (bambu-lab-h2d patch). Studio writes a description of the plate to request.json and runs
+// /opt/studio-ai/on-click <request.json> <response.json> (mounted from the host, so it changes without a
+// rebuild). The hook asks the gateway, which asks Claude; Studio then shows the proposed process settings
+// and loads the accepted ones into the edited process preset, like a manual edit (orange, resettable).
+namespace {
+const std::string AI_HOOK = "/opt/studio-ai/on-click";
+const std::string AI_DIR  = "/tmp/studio-ai";
+
+std::vector<double> ai_floats(const DynamicPrintConfig &config, const std::string &key)
+{
+    const ConfigOption *opt = config.option(key);
+    if (auto *nullable = dynamic_cast<const ConfigOptionFloatsNullable *>(opt))
+        return nullable->values;
+    if (auto *floats = dynamic_cast<const ConfigOptionFloats *>(opt))
+        return floats->values;
+    return {};
+}
+
+// The outline of a placed mesh seen from above: the convex hull of its vertices (monotone chain), in mm
+// from the corner of its plate, so the dashboard can draw the plate and let the user point at an object
+nlohmann::json ai_footprint(const indexed_triangle_set &its, const Vec3d &origin)
+{
+    std::vector<Vec2d> points;
+    points.reserve(its.vertices.size());
+    for (const auto &v : its.vertices)
+        points.emplace_back(std::round((v.x() - origin.x()) * 10.) / 10., std::round((v.y() - origin.y()) * 10.) / 10.);
+    std::sort(points.begin(), points.end(), [](const Vec2d &a, const Vec2d &b) { return a.x() < b.x() || (a.x() == b.x() && a.y() < b.y()); });
+    points.erase(std::unique(points.begin(), points.end()), points.end());
+    nlohmann::json outline = nlohmann::json::array();
+    if (points.size() < 3)
+        return outline;
+    auto cross = [](const Vec2d &o, const Vec2d &a, const Vec2d &b) { return (a.x() - o.x()) * (b.y() - o.y()) - (a.y() - o.y()) * (b.x() - o.x()); };
+    std::vector<Vec2d> hull(2 * points.size());
+    size_t k = 0;
+    for (size_t i = 0; i < points.size(); ++i) {
+        while (k >= 2 && cross(hull[k - 2], hull[k - 1], points[i]) <= 0) --k;
+        hull[k++] = points[i];
+    }
+    for (size_t i = points.size() - 1, t = k + 1; i > 0; --i) {
+        while (k >= t && cross(hull[k - 2], hull[k - 1], points[i - 1]) <= 0) --k;
+        hull[k++] = points[i - 1];
+    }
+    hull.resize(k - 1);
+    for (const Vec2d &p : hull)
+        outline.push_back({p.x(), p.y()});
+    return outline;
+}
+
+// The outline of a placed mesh seen from above, as Studio draws it on the plate (teeth, holes and all): the union
+// of its upward-facing triangles, simplified to 0.1 mm, as rings in mm from the corner of its plate (outer
+// contours and holes, drawn even-odd)
+nlohmann::json ai_outline(const indexed_triangle_set &its, const Vec3d &origin)
+{
+    Polygons triangles;
+    triangles.reserve(its.indices.size() / 2);
+    for (const auto &face : its.indices) {
+        const Vec3f &a = its.vertices[face[0]];
+        const Vec3f &b = its.vertices[face[1]];
+        const Vec3f &c = its.vertices[face[2]];
+        // Facing down or edge-on: the faces facing up already cover the outline of a closed mesh
+        if ((b.x() - a.x()) * (c.y() - a.y()) - (b.y() - a.y()) * (c.x() - a.x()) <= 0.f)
+            continue;
+        Polygon triangle;
+        for (const Vec3f *v : {&a, &b, &c})
+            triangle.points.emplace_back(coord_t(std::round((v->x() - origin.x()) / SCALING_FACTOR)), coord_t(std::round((v->y() - origin.y()) / SCALING_FACTOR)));
+        triangles.emplace_back(std::move(triangle));
+    }
+    nlohmann::json rings = nlohmann::json::array();
+    size_t points = 0;
+    auto add_ring = [&](const Polygon &polygon) {
+        nlohmann::json corners = nlohmann::json::array();
+        for (const Point &p : polygon.points)
+            corners.push_back({std::round(p.x() * SCALING_FACTOR * 10.) / 10., std::round(p.y() * SCALING_FACTOR * 10.) / 10.});
+        points += polygon.points.size();
+        rings.push_back(std::move(corners));
+    };
+    for (const ExPolygon &shape : union_ex(triangles)) {
+        for (const ExPolygon &simple : shape.simplify(0.1 / SCALING_FACTOR)) {
+            add_ring(simple.contour);
+            for (const Polygon &hole : simple.holes)
+                add_ring(hole);
+        }
+        // A very detailed object: what is drawn so far is enough to point at it
+        if (points > 6000)
+            break;
+    }
+    return rings;
+}
