+// The print report: which recorded print it is about (with the camera's photo of it), how it came out,
+// what went wrong, and notes. Prints, outcomes and problems all come from the gateway (GET prints).
+class AiReportDialog : public wxDialog
+{
+public:
+    explicit AiReportDialog(wxWindow *parent, const nlohmann::json &list)
+        : wxDialog(parent, wxID_ANY, wxString::FromUTF8("Báo cáo kết quả in"), wxDefaultPosition, wxDefaultSize, wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER)
+        , m_prints(list.value("prints", nlohmann::json::array()))
+        , m_outcomes(list.value("outcomes", nlohmann::json::array()))
+        , m_issues(list.value("issues", nlohmann::json::array()))
+    {
+        const int gap = FromDIP(12);
+        auto *sizer = new wxBoxSizer(wxVERTICAL);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Bản in:")), 0, wxLEFT | wxRIGHT | wxTOP, gap);
+        wxArrayString labels;
+        int selected = -1;
+        for (size_t i = 0; i < m_prints.size(); ++i) {
+            const nlohmann::json &p = m_prints[i];
+            const std::string status = p.value("status", "");
+            const bool reported = p.contains("feedback_outcome") && p["feedback_outcome"].is_string();
+            // Preselect the newest print that has ended and has no report yet
+            if (selected < 0 && status != "printing" && !reported)
+                selected = int(i);
+            wxString name = wxString::FromUTF8(p.value("job_name", ""));
+            if (name.length() > 40)
+                name = name.Left(39) + wxString::FromUTF8("…");
+            const char *status_text = status == "finished" ? "hoàn thành" : status == "failed" ? "lỗi" : "đang in";
+            const bool with_ai = p.contains("ai_session_id") && p["ai_session_id"].is_string();
+            // Studio runs with LC_ALL=C, so text with accents or symbols always goes through FromUTF8
+            labels.Add(wxString::Format(wxString::FromUTF8("%s · %s · %s%s%s"), ai_session_time(p.value("id", "")), name,
+                                        wxString::FromUTF8(status_text), wxString::FromUTF8(with_ai ? " · AI" : ""),
+                                        wxString::FromUTF8(reported ? " · đã báo cáo" : "")));
+        }
+        m_choice = new wxChoice(this, wxID_ANY, wxDefaultPosition, wxDefaultSize, labels);
+        m_choice->SetSelection(selected >= 0 ? selected : 0);
+        sizer->Add(m_choice, 0, wxALL | wxEXPAND, gap);
+
+        auto *detail_row = new wxBoxSizer(wxHORIZONTAL);
+        m_photo = new wxStaticBitmap(this, wxID_ANY, wxNullBitmap, wxDefaultPosition, wxSize(FromDIP(PHOTO_WIDTH), FromDIP(PHOTO_HEIGHT)));
+        detail_row->Add(m_photo, 0, wxRIGHT, gap);
+        m_detail = new wxStaticText(this, wxID_ANY, wxEmptyString);
+        detail_row->Add(m_detail, 1, wxEXPAND);
+        sizer->Add(detail_row, 0, wxLEFT | wxRIGHT | wxEXPAND, gap);
+
+        wxArrayString outcome_labels;
+        for (const nlohmann::json &o : m_outcomes)
+            outcome_labels.Add(wxString::FromUTF8(o.value("label", "")));
+        m_outcome = new wxRadioBox(this, wxID_ANY, wxString::FromUTF8("Kết quả in"), wxDefaultPosition, wxDefaultSize, outcome_labels,
+                                   int(outcome_labels.size()), wxRA_SPECIFY_COLS);
+        sizer->Add(m_outcome, 0, wxALL | wxEXPAND, gap);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Lỗi gặp phải:")), 0, wxLEFT | wxRIGHT, gap);
+        wxArrayString issue_labels;
+        for (const nlohmann::json &issue : m_issues)
+            issue_labels.Add(wxString::FromUTF8(issue.value("label", "")));
+        m_issue_list = new wxCheckListBox(this, wxID_ANY, wxDefaultPosition, wxSize(-1, FromDIP(170)), issue_labels);
+        sizer->Add(m_issue_list, 0, wxALL | wxEXPAND, gap);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Ghi chú (vị trí lỗi, bạn đã chỉnh gì thêm...):")), 0, wxLEFT | wxRIGHT, gap);
+        m_note = new wxTextCtrl(this, wxID_ANY, wxEmptyString, wxDefaultPosition, wxSize(FromDIP(600), FromDIP(80)), wxTE_MULTILINE | wxTE_WORDWRAP);
+        sizer->Add(m_note, 0, wxALL | wxEXPAND, gap);
+
+        sizer->Add(new wxStaticText(this, wxID_ANY, wxString::FromUTF8("Thêm ảnh chụp và so sánh các bản in trên dashboard, thẻ Lịch sử in.")),
+                   0, wxLEFT | wxRIGHT, gap);
+
+        auto *buttons = new wxBoxSizer(wxHORIZONTAL);
+        auto *send    = new wxButton(this, wxID_OK, wxString::FromUTF8("Gửi báo cáo"));
+        send->SetDefault();
+        buttons->AddStretchSpacer();
