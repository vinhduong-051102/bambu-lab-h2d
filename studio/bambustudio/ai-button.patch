+bool MainFrame::ai_run(const std::string &command, std::function<void()> done)
+{
+    if (ai_run_async(command, std::move(done)))
+        return true;
+    MessageDialog dlg(this, wxString::FromUTF8("Không chạy được ") + wxString::FromUTF8(command), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_ERROR);
+    dlg.ShowModal();
+    return false;
+}
+
+void MainFrame::ai_optimize(const std::string &follow_up_session, const wxString &comment)
+{
+    // While the AI works, the button brings back its progress window
+    if (m_ai_running) {
+        if (m_ai_progress != nullptr) {
+            m_ai_progress->Show();
+            m_ai_progress->Raise();
+        }
+        return;
+    }
+    if (!wxFileName::IsFileExecutable(AI_HOOK)) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chức năng AI tối ưu sắp có."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+    if (wxGetApp().plater()->model().objects.empty()) {
+        MessageDialog dlg(this, wxString::FromUTF8("Hãy thêm mẫu lên bàn in trước khi dùng AI tối ưu."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+
+    const std::string request_path  = AI_DIR + "/request.json";
+    const std::string response_path = AI_DIR + "/response.json";
+    wxString plate;
+    try {
+        nlohmann::json request = ai_describe_plate();
+        // "Hỏi lại AI": the gateway puts the earlier proposal and this comment in the prompt
+        if (!follow_up_session.empty())
+            request["follow_up"] = {{"session_id", follow_up_session}, {"comment", comment.ToUTF8().data()}};
+        size_t settings = request["settings"].size();
+        for (const nlohmann::json &filament : request["filaments"])
+            if (filament.value("used", false) && filament.contains("settings"))
+                settings += filament["settings"].size();
+        plate = wxString::Format(wxString::FromUTF8(": %d vật thể, %d setting"), int(request["objects"].size()), int(settings));
+        boost::filesystem::remove(response_path);
+        boost::filesystem::remove(response_path + ".progress");
+        ai_write_json(request_path, request);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI optimize: " << e.what();
+        MessageDialog dlg(this, wxString::FromUTF8("Không ghi được dữ liệu mẫu để gửi cho AI."), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+
+    // Its own process group, so cancelling stops the hook and everything it started
+    const std::string command = AI_HOOK + " " + request_path + " " + response_path;
+    m_ai_cancelled = false;
+    m_ai_pid = ai_run_async(command, [this, response_path]() {
+        const bool cancelled = m_ai_cancelled;
+        ai_progress_stop();
+        if (!cancelled)
+            ai_optimize_apply(response_path);
+    }, wxEXEC_MAKE_GROUP_LEADER);
+    if (m_ai_pid == 0) {
+        MessageDialog dlg(this, wxString::FromUTF8("Không chạy được ") + wxString::FromUTF8(command), wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    m_ai_running = true;
+    m_ai_btn->SetLabel(wxString::FromUTF8("AI đang phân tích..."));
+    m_ai_btn->SetToolTip(wxString::FromUTF8("Xem tiến trình AI"));
+    Layout();
+    ai_progress_start(plate, response_path + ".progress");
+}
+
+void MainFrame::ai_progress_start(const wxString &plate, const std::string &progress_path)
+{
+    m_ai_started_ms = wxGetLocalTimeMillis().GetValue();
+    auto *dialog = new AiProgressDialog(this, plate, [this]() {
+        // The hook's whole process group; on-click passes it on to claude
+        m_ai_cancelled = true;
+        if (m_ai_pid != 0)
+            wxProcess::Kill(int(m_ai_pid), wxSIGTERM, wxKILL_CHILDREN);
+    });
+    m_ai_progress      = dialog;
+    m_ai_progress_path = progress_path;
+    dialog->Show();
+    if (m_ai_timer == nullptr) {
+        m_ai_timer = new wxTimer(this);
+        Bind(wxEVT_TIMER, [this](wxTimerEvent &) { ai_progress_tick(); }, m_ai_timer->GetId());
+    }
+    m_ai_timer->Start(500);
+    ai_progress_tick();
+}
+
+void MainFrame::ai_progress_tick()
+{
+    auto *dialog = static_cast<AiProgressDialog *>(m_ai_progress);
+    if (dialog == nullptr)
+        return;
+    const long long seconds = (wxGetLocalTimeMillis().GetValue() - m_ai_started_ms) / 1000;
+    const wxString elapsed = wxString::Format(wxString::FromUTF8("Đã chạy %lld:%02lld"), seconds / 60, seconds % 60);
+
+    // Studio has read the plate by now; on-click says where it got
+    int current = 1;
+    wxString detail = elapsed;
+    wxString notes;
+    if (std::optional<nlohmann::json> progress = ai_read_progress(m_ai_progress_path)) {
+        const std::string step    = progress->value("step", "");
+        const int         changes = progress->value("changes", 0);
+        int               lines   = 0;
+        for (const nlohmann::json &note : progress->value("notes", nlohmann::json::array()))
+            if (note.is_string()) {
+                notes += (lines++ > 0 ? wxString("\n") : wxString()) + wxString::FromUTF8(note.get<std::string>());
+            }
+        if (step == "gateway") {
+            // The gateway asks Claude with its API key in one go: nothing finer to show
+            current = 2;
+            detail += wxString::FromUTF8(" · Gateway đang hỏi Claude bằng API key, không xem được chi tiết từng bước");
+        } else {
+            for (int i = 0; i < AI_STEP_COUNT; ++i)
+                if (step == AI_STEPS[i].id)
+                    current = i;
+            if (step == "thinking" && lines > 0)
+                detail += wxString::Format(wxString::FromUTF8(" · Claude đã phân tích %d ý, chưa viết đề xuất"), lines);
+            else if (step == "thinking")
+                detail += wxString::FromUTF8(" · Claude đang suy nghĩ, chưa viết đề xuất");
+            else if (step == "writing")
+                detail += wxString::Format(wxString::FromUTF8(" · Đã viết %d thay đổi"), changes);
+            else if (step == "check")
+                detail += wxString::Format(wxString::FromUTF8(" · Kiểm tra %d thay đổi"), changes);
+        }
+    }
+    dialog->show_step(current, detail, notes);
+}
+
+void MainFrame::ai_progress_stop()
+{
+    if (m_ai_timer != nullptr)
+        m_ai_timer->Stop();
+    if (m_ai_progress != nullptr) {
+        m_ai_progress->Destroy();
+        m_ai_progress = nullptr;
+    }
+    m_ai_pid     = 0;
+    m_ai_running = false;
+    m_ai_btn->SetLabel(wxString::FromUTF8("AI tối ưu"));
+    m_ai_btn->SetToolTip(wxString::FromUTF8("AI phân tích mẫu và tối ưu setting"));
+    Layout();
+}
+
+void MainFrame::ai_optimize_apply(const std::string &response_path)
+{
+    const wxString title = wxString::FromUTF8("AI tối ưu");
+    const std::optional<nlohmann::json> response = ai_read_json(response_path);
+    if (!response) {
+        MessageDialog dlg(this, wxString::FromUTF8("Không đọc được kết quả từ AI. Kiểm tra gateway và STUDIO_AI_URL."), title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    if (!response->value("success", false)) {
+        wxString message = ai_text(*response, "message");
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("AI không xử lý được yêu cầu.") : message, title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    std::string session_id = response->value("session_id", "");
+    if (!ai_safe_id(session_id))
+        session_id.clear();
+
+    // The gateway already checked the keys and values; Studio still refuses anything that is not a
+    // non-text setting of the preset it is for, and anything its own parser rejects. Filament changes
+    // go to a single filament preset (the gateway keeps them to one): Studio edits one at a time.
+    PresetBundle &bundle = *wxGetApp().preset_bundle;
+    const DynamicPrintConfig &print_config = bundle.prints.get_edited_preset().config;
+    DynamicPrintConfig proposed, proposed_filament;
+    std::string filament_preset;
+    int filament_index = -1;
+    nlohmann::json applied = nlohmann::json::array(), applied_filament = nlohmann::json::array();
+    wxString lines;
+    const nlohmann::json changes = response->value("changes", nlohmann::json::array());
+    for (const nlohmann::json &change : changes) {
+        const std::string key   = change.value("key", "");
+        const std::string value = change.value("value", "");
+        const bool for_filament = change.value("target", "") == "filament";
+        const DynamicPrintConfig *config = &print_config;
+        int index = -1;
+        if (for_filament) {
+            index = change.value("filament", 0) - 1;
+            if (index < 0 || index >= int(bundle.filament_presets.size()))
+                continue;
+            const std::string name = bundle.filament_presets[index];
+            if (!filament_preset.empty() && name != filament_preset)
+                continue;
+            // The edited copy when this preset is the one open in the Filament tab
+            const Preset *preset = bundle.filaments.find_preset(name, false);
+            if (preset == nullptr)
+                continue;
+            config = &preset->config;
+            if (filament_preset.empty()) {
+                filament_preset = name;
+                filament_index  = index;
+            }
+        }
+        const ConfigOptionDef *def = print_config_def.get(key);
+        if (def == nullptr || def->type == coString || def->type == coStrings || !config->has(key))
+            continue;
+        try {
+            ConfigSubstitutionContext context(ForwardCompatibilitySubstitutionRule::Disable);
+            (for_filament ? proposed_filament : proposed).set_deserialize(key, value, context);
+        } catch (const std::exception &e) {
+            BOOST_LOG_TRIVIAL(warning) << "AI optimize: " << key << " = " << value << " rejected: " << e.what();
+            continue;
+        }
+        if (for_filament)
+            applied_filament.push_back({{"key", key}, {"value", value}, {"target", "filament"}, {"filament", index + 1}});
+        else
+            applied.push_back({{"key", key}, {"value", value}});
+        wxString label = ai_text(change, "label");
+        if (label.empty())
+            label = wxString::FromUTF8(key);
+        if (for_filament)
+            label = wxString::Format("Filament #%d: ", index + 1) + label;
+        lines += wxString::Format(wxString::FromUTF8("• %s: %s → %s\n   %s\n\n"), label, wxString::FromUTF8(config->opt_serialize(key)),
+                                  wxString::FromUTF8(value), ai_text(change, "reason"));
+    }
+    if (proposed.empty() && proposed_filament.empty())
+        lines = wxString::FromUTF8("Setting hiện tại đã phù hợp, AI không đề xuất thay đổi nào.");
+    else if (!proposed_filament.empty())
+        lines += wxString::FromUTF8("Thay đổi filament được nạp vào preset ") + wxString::FromUTF8(filament_preset) +
+                 wxString::FromUTF8(" (tab Filament), như khi tự sửa: lưu preset nếu muốn giữ cho lần sau.");
+
+    AiResultDialog dlg(this, ai_text(*response, "summary"), lines, !proposed.empty() || !proposed_filament.empty());
+    const int answer = dlg.ShowModal();
+    if (answer == ID_AI_ASK_AGAIN) {
+        // Back to the button's busy state; the new answer opens this dialog again
+        const wxString comment = dlg.comment();
+        CallAfter([this, session_id, comment]() { ai_optimize(session_id, comment); });
+        return;
+    }
+    if (answer != wxID_APPLY)
+        return;
+
+    // Filament first: opening another preset in the Filament tab may ask what to do with unsaved edits
+    // of the one open now (Studio's own dialog), and the user may cancel that
+    if (!proposed_filament.empty()) {
+        Tab *tab = wxGetApp().get_tab(Preset::TYPE_FILAMENT);
+        const bool open = tab != nullptr && (bundle.filaments.get_edited_preset().name == filament_preset || tab->select_preset(filament_preset));
+        if (open) {
+            // As the sidebar's edit button does: the tab now edits this filament
+            tab->get_combo_box()->set_filament_idx(filament_index);
+            tab->load_config(proposed_filament);
+            for (const nlohmann::json &change : applied_filament)
+                applied.push_back(change);
+        } else {
+            MessageDialog info(this, wxString::FromUTF8("Chưa đổi preset filament ") + wxString::FromUTF8(filament_preset) +
+                                         wxString::FromUTF8(": chỉ áp dụng thay đổi của quá trình in."),
+                               wxString::FromUTF8("AI tối ưu"), wxOK | wxICON_INFORMATION);
+            info.ShowModal();
+        }
+    }
+
+    // Same follow-up as editing the density in the Process tab (Tab::on_value_change)
+    if (proposed.has("sparse_infill_density")) {
+        for (const char *linked : {"skeleton_infill_density", "skin_infill_density"})
+            if (print_config.has(linked))
+                proposed.set_key_value(linked, proposed.option("sparse_infill_density")->clone());
+    }
+    if (Tab *tab = wxGetApp().get_tab(Preset::TYPE_PRINT); tab != nullptr && !proposed.empty())
+        tab->load_config(proposed);
+    if (applied.empty())
+        return;
+    // The next print sent from Studio is linked to this proposal in the print history
+    m_ai_last_applied_session = session_id;
+
+    // Lets the print report know which proposal was used; nothing for the user to wait on or see
+    if (!session_id.empty() && wxFileName::IsFileExecutable(AI_GATEWAY)) {
+        try {
+            const std::string body = AI_DIR + "/applied.json";
+            ai_write_json(body, {{"changes", applied}});
+            ai_run(AI_GATEWAY + " POST studio/ai-sessions/" + session_id + "/applied " + body + " " + AI_DIR + "/applied-response.json", []() {});
+        } catch (const std::exception &e) {
+            BOOST_LOG_TRIVIAL(warning) << "AI optimize: applied changes not recorded: " << e.what();
+        }
+    }
+}
+
+void MainFrame::ai_report()
+{
+    if (m_ai_reporting)
+        return;
+    const wxString title = wxString::FromUTF8("Báo cáo kết quả in");
+    if (!wxFileName::IsFileExecutable(AI_GATEWAY)) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chưa có script /opt/studio-ai/gateway để gửi báo cáo."), title, wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+    const std::string list_path = AI_DIR + "/prints.json";
+    try {
+        boost::filesystem::create_directories(AI_DIR);
+        boost::filesystem::remove(list_path);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI report: " << e.what();
+    }
+
+    const bool started = ai_run(AI_GATEWAY + " GET prints?limit=30 - " + list_path, [this, list_path]() {
+        m_ai_reporting = false;
+        m_ai_report_btn->Enable();
+        ai_report_show(list_path);
+    });
+    if (!started)
+        return;
+    m_ai_reporting = true;
+    m_ai_report_btn->Enable(false);
+}
+
+void MainFrame::ai_report_show(const std::string &list_path)
+{
+    const wxString title = wxString::FromUTF8("Báo cáo kết quả in");
+    const std::optional<nlohmann::json> list = ai_read_json(list_path);
+    if (!list || !list->value("success", false)) {
+        wxString message = list ? ai_text(*list, "message") : wxString();
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("Không lấy được lịch sử in từ gateway.") : message, title, wxOK | wxICON_ERROR);
+        dlg.ShowModal();
+        return;
+    }
+    if (list->value("prints", nlohmann::json::array()).empty()) {
+        MessageDialog dlg(this, wxString::FromUTF8("Chưa có bản in nào được ghi lại. Gateway ghi lại mỗi bản in gửi từ Studio, kèm ảnh camera khi in xong."),
+                          title, wxOK | wxICON_INFORMATION);
+        dlg.ShowModal();
+        return;
+    }
+
+    AiReportDialog dlg(this, *list);
+    if (dlg.ShowModal() != wxID_OK || !ai_safe_id(dlg.print_id()))
+        return;
+    const std::string body          = AI_DIR + "/feedback.json";
+    const std::string response_path = AI_DIR + "/feedback-response.json";
+    try {
+        boost::filesystem::remove(response_path);
+        ai_write_json(body, dlg.feedback());
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "AI report: " << e.what();
+        MessageDialog error(this, wxString::FromUTF8("Không ghi được báo cáo để gửi."), title, wxOK | wxICON_ERROR);
+        error.ShowModal();
+        return;
+    }
+    ai_run(AI_GATEWAY + " POST prints/" + dlg.print_id() + "/feedback " + body + " " + response_path, [this, response_path, title]() {
+        const std::optional<nlohmann::json> response = ai_read_json(response_path);
+        const bool ok = response && response->value("success", false);
+        wxString message = ok ? wxString::FromUTF8("Đã gửi báo cáo. Cảm ơn bạn!") : (response ? ai_text(*response, "message") : wxString());
+        MessageDialog dlg(this, message.empty() ? wxString::FromUTF8("Không gửi được báo cáo.") : message, title, wxOK | (ok ? wxICON_INFORMATION : wxICON_ERROR));
+        dlg.ShowModal();
+    });
+}
+
+void MainFrame::ai_record_print_setup(const std::string &job_name)
+{
+    // Print history: the gateway pairs these settings with the print the printer reports under this job
+    // name. Nothing for the user to wait on or see; a failure only costs the settings in the history.
+    if (job_name.empty() || !wxFileName::IsFileExecutable(AI_GATEWAY))
+        return;
+    try {
+        nlohmann::json setup = ai_describe_plate();
+        setup["job_name"] = job_name;
+        setup["ai_session_id"] = m_ai_last_applied_session.empty() ? nlohmann::json(nullptr) : nlohmann::json(m_ai_last_applied_session);
+        const std::string body = AI_DIR + "/print-setup.json";
+        ai_write_json(body, setup);
+        ai_run_async(AI_GATEWAY + " POST prints/setup " + body + " " + AI_DIR + "/print-setup-response.json", []() {});
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(warning) << "Print history: settings not sent: " << e.what();
+    }
 }
 
