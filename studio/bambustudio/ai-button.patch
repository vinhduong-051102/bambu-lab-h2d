+    // Marks the steps before `current` done; `detail` goes under the progress bar, `notes` (one per line)
+    // in the analysis box, which keeps its placeholder until Claude writes the first one
+    void show_step(int current, const wxString &detail, const wxString &notes)
+    {
+        if (!notes.empty() && m_notes->GetValue() != notes) {
+            m_notes->ChangeValue(notes);
+            m_notes->ShowPosition(m_notes->GetLastPosition());
+        }
+        for (int i = 0; i < AI_STEP_COUNT; ++i) {
+            wxString label = wxString::FromUTF8(i < current ? "✓  " : i == current ? "●  " : "○  ") + wxString::FromUTF8(AI_STEPS[i].label);
+            if (i == 0)
+                label += m_plate;
+            if (m_steps[i]->GetLabel() != label)
+                m_steps[i]->SetLabel(label);
+            m_steps[i]->Enable(i <= current);
+        }
+        if (m_cancel->IsEnabled() && m_detail->GetLabel() != detail) {
+            m_detail->SetLabel(detail);
+            Layout();
+        }
+        m_gauge->Pulse();
+    }
+
+private:
+    wxString      m_plate;
+    wxStaticText *m_steps[AI_STEP_COUNT];
+    wxStaticText *m_detail;
+    wxTextCtrl   *m_notes;
+    wxGauge      *m_gauge;
+    wxButton     *m_cancel;
+};
+
+// The progress on-click last wrote, or nullopt while there is none; quiet, as it is read twice a second
+std::optional<nlohmann::json> ai_read_progress(const std::string &path)
+{
+    std::ifstream in(path, std::ios::binary);
+    if (!in)
+        return std::nullopt;
+    nlohmann::json progress = nlohmann::json::parse(in, nullptr, false);
+    if (progress.is_discarded() || !progress.is_object())
+        return std::nullopt;
+    return progress;
+}
