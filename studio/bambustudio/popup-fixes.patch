@@ -973,10 +973,13 @@ void ParamTooltip::OnTimer(wxTimerEvent &)
             m_timer->StartOnce(HIDE_DELAY_MS);
             return;
         }
-        wxPopupTransientWindow::Hide();
+        wxPopupWindow::Show(false);
