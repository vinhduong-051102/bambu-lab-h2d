{
  "name": "bambu-h2d-gateway",
  "version": "1.0.0",
  "description": "Local LAN Gateway for Bambu Lab H2D 3D Printer over MQTT TLS with Next.js dashboard, REST API & WebSocket",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "bambu-lab",
    "h2d",
    "mqtt",
    "iot",
    "gateway",
    "3d-printer",
    "nextjs",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "basic-ftp": "^6.2.3",
    "dotenv": "^16.4.5",
    "fflate": "^0.8.3",
    "mqtt": "^5.10.1",
    "next": "^16.4.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
