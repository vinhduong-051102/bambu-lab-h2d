# Bambu Lab Printer Credentials
BAMBU_HOST=192.168.1.100
BAMBU_PORT=8883
BAMBU_FTP_PORT=990
BAMBU_SERIAL=01S00A123456789
BAMBU_ACCESS_CODE=12345678

# Gateway HTTP & WebSocket Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Safety & Control Settings
BAMBU_REAL_PRINTER=true
GATEWAY_API_KEY=
COMMAND_TIMEOUT_MS=10000

# Logging & Debug Options
LOG_LEVEL=info
BAMBU_DEBUG_PROTOCOL=false
PRINTER_OFFLINE_TIMEOUT_MS=30000
ENABLE_RAW_API=true

# Gateway-side slicing of unsliced .3mf projects (optional).
# Build the image first: docker build -t bambu-h2d-slicer:02.08.02.61 slicer/
SLICER_DOCKER_IMAGE=
SLICER_TIMEOUT_MS=600000
# Build plate on the printer: Textured PEI Plate, Cool Plate, Engineering Plate, High Temp Plate, Supertack Plate.
# Empty: the project's plate, or Textured PEI for a project made for another printer.
SLICER_BED_TYPE=

# Bambu Studio embedded in the dashboard (optional, see docs/studio.md).
# Start it first: docker compose -f docker-compose.studio.yml up -d
STUDIO_URL=
STUDIO_EXPORT_DIR=
