# Bambu Lab Printer Credentials
BAMBU_HOST=192.168.1.100
BAMBU_PORT=8883
BAMBU_FTP_PORT=990
BAMBU_SERIAL=01S00A123456789
BAMBU_ACCESS_CODE=12345678

# Gateway HTTP & WebSocket Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Safety & Control Settings
BAMBU_REAL_PRINTER=true
GATEWAY_API_KEY=
COMMAND_TIMEOUT_MS=10000

# Logging & Debug Options
LOG_LEVEL=info
BAMBU_DEBUG_PROTOCOL=false
PRINTER_OFFLINE_TIMEOUT_MS=30000
ENABLE_RAW_API=true

# Bambu Studio embedded in the dashboard (optional, see docs/studio.md).
# Start it first: docker compose -f docker-compose.studio.yml up -d
STUDIO_URL=
# Other addresses Studio is published at, comma-separated (e.g. https://<machine>.<tailnet>.ts.net:8443/
# from `tailscale serve`); picked when the dashboard is opened from the same host
STUDIO_ALT_URLS=
STUDIO_IMPORT_DIR=

# "AI tối ưu" button in Bambu Studio (see docs/studio.md): Claude API key and model
ANTHROPIC_API_KEY=
STUDIO_AI_MODEL=claude-opus-5-5
