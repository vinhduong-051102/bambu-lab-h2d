# Bambu Lab Printer Credentials
BAMBU_HOST=192.168.1.100
BAMBU_PORT=8883
BAMBU_FTP_PORT=990
BAMBU_SERIAL=01S00A123456789
BAMBU_ACCESS_CODE=12345678

# Gateway HTTP & WebSocket Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# HTTPS next to HTTP (empty = off), with a self-signed certificate made in data/certs for these
# comma-separated names/IPs (LAN IP, Tailscale IP or name); delete data/certs to make a new one
HTTPS_PORT=
HTTPS_HOSTNAMES=

# Safety & Control Settings
BAMBU_REAL_PRINTER=true
GATEWAY_API_KEY=
COMMAND_TIMEOUT_MS=10000

# Logging & Debug Options
LOG_LEVEL=info
BAMBU_DEBUG_PROTOCOL=false
PRINTER_OFFLINE_TIMEOUT_MS=30000
ENABLE_RAW_API=true

# Bambu Studio embedded in the dashboard (optional, see docs/studio.md).
# Start it first: docker compose -f docker-compose.studio.yml up -d
STUDIO_URL=
# Other addresses Studio is published at, comma-separated (e.g. https://<machine>.<tailnet>.ts.net:8443/
# from `tailscale serve`); picked when the dashboard is opened from the same host
STUDIO_ALT_URLS=
STUDIO_IMPORT_DIR=

# "AI tối ưu" button in Bambu Studio (see docs/studio.md): a Claude subscription token from
# `claude setup-token` (used by Studio's container, no API key needed), or else a Claude API key for the gateway
CLAUDE_CODE_OAUTH_TOKEN=
# A second subscription's token, used once the one above has hit its usage limit
CLAUDE_CODE_OAUTH_TOKEN_FALLBACK=
ANTHROPIC_API_KEY=
STUDIO_AI_MODEL=claude-opus-5-5
# Where each AI proposal, the changes applied from it and the user's print report are kept
STUDIO_AI_DATA_DIR=./data/studio/ai
# Print history: each print's camera photo, uploaded photos, the settings Studio sent and the report
PRINT_HISTORY_DIR=./data/prints
# Timelapse videos and thumbnails copied from the printer the first time they are watched
TIMELAPSE_CACHE_DIR=./data/timelapse
# "AI nhận xét" on a timelapse: Claude looks at the video's frames and says what to change next time;
# "Dùng cho lần in sau" lets "AI tối ưu" read it. Runs `claude -p` (Claude Code) on this machine with CLAUDE_CODE_OAUTH_TOKEN
TIMELAPSE_AI_MODEL=claude-opus-5-5
# "Thành phần của mẫu" (docs/studio.md): the parts measured by the mesh3d container (MESH_WORKER_URL below,
# with STUDIO_IMPORT_DIR mounted), kept here with their renders, and the model that names them
MODEL_ANALYSIS_DIR=./data/studio/analyses
PARTS_AI_MODEL=claude-opus-5-5

# "Thiết kế mô hình bằng AI" (see docs/cad.md): Claude designs models in the CAD container, on the same
# CLAUDE_CODE_OAUTH_TOKEN. Start it first: docker compose -f docker-compose.cad.yml up -d --build
CAD_WORKER_URL=
CAD_JOBS_DIR=./data/cad/jobs
CAD_AI_MODEL=claude-opus-5-5

# Figures (characters, decorations): from a picture Hunyuan3D-2 shapes them on the NVIDIA GPU and Claude finishes
# them in Blender through MCP for Blender; from a description Claude makes them there (see docs/cad.md).
# Start it first: docker compose -f docker-compose.mesh3d.yml up -d --build
MESH_WORKER_URL=
# Interactive simulation (docs/interactive-physics.md): Chrono kept running while the dashboard drags and pushes
# bodies. Start it with: docker compose -f docker-compose.sim-live.yml up -d
SIM_LIVE_URL=
# Where mesh3d keeps its model weights (~25 GB; see docs/cad.md)
MESH_MODELS_DIR=./data/mesh3d/models
# Bambu Studio data downloaded once (colour catalogue, mixing recipes) and the saved "Filament của tôi"
BAMBU_COLOR_CODES_FILE=./data/bambu/filaments_color_codes.json
BAMBU_MIX_RECIPES_FILE=./data/bambu/standard_color_recipes.json
CUSTOM_FILAMENTS_FILE=./data/filaments/custom.json
